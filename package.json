{
  "name": "encrypt-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Чат со сквозным шифрованием на Next.js + Socket.IO: сервер лишь проксирует шифрованные сообщения и раздаёт открытые ключи, комнаты живут только в оперативной памяти",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.22.3",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
